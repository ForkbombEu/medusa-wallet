{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!brand",
      "!directives",
      "!HITL",
      "!AGENTS.md",
      "!CONTRIBUTING.md",
      "!DESIGN.md",
      "!docs/CREATE_PROJECT.md"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noConsole": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "commander": "core is UI-agnostic: CLI code belongs in packages/cli.",
                  "@medusa-wallet/cli": "core must not depend on a frontend.",
                  "node:process": "core must not read process state: take configuration as arguments."
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "process": "core must not read process state: take configuration as arguments.",
                  "console": "core must not print: return data and let the frontend render it."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/src/**", "packages/cli/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@credo-ts/*", "@openid4vc/*", "@openwallet-foundation/*"],
                    "message": "The CLI talks only to @medusa-wallet/core: add what you need to core's public API."
                  }
                ]
              }
            }
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
